# Copy this file to .env.deploy on the deployment host.
# Replace every change-me value before starting services, especially JWT_SECRET.
# The placeholder below is intentionally invalid as a production secret even though
# its length passes the API's minimum-length check. Do not commit real secrets.

VIDEO_APP_HTTP_PORT=8083
VIDEO_APP_WEB_PORT=1325
JWT_SECRET=change-me-with-at-least-32-random-characters

POSTGRES_DSN=host=10.200.10.12 user=postgres password=change-me dbname=video-app port=5432 sslmode=disable TimeZone=Asia/Shanghai
REDIS_PASSWORD=
COS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

DASHSCOPE_API_KEY=change-me
OPENAI_API_KEY=
EMBEDDING_API_KEY=
ASR_API_KEY=

GORSE_API_KEY=change-me-gorse-api-key
GORSE_SERVER_API_KEY=change-me-gorse-api-key
GORSE_DASHBOARD_USERNAME=admin
GORSE_DASHBOARD_PASSWORD=change-me-dashboard-password
GORSE_CACHE_STORE=postgres://postgres:change-me@host.docker.internal:5432/video-app?sslmode=disable&search_path=gorse,public
GORSE_DATA_STORE=postgres://postgres:change-me@host.docker.internal:5432/video-app?sslmode=disable&search_path=gorse,public
GORSE_MASTER_GRPC_PORT=8086
GORSE_DASHBOARD_PORT=8088

MIGRATE_SOURCE_ACCESS_KEY=change-me
MIGRATE_SOURCE_SECRET_KEY=change-me
MIGRATE_TARGET_ACCESS_KEY=change-me
MIGRATE_TARGET_SECRET_KEY=change-me
