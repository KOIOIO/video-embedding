# Copy this file to .env.deploy on the deployment host.
# Replace every change-me value before starting services. Do not commit real secrets.

HSTV_HTTP_PORT=8083
HSTV_WEB_PORT=1325
JWT_SECRET=change-me-at-least-32-characters-long

POSTGRES_DSN=host=10.200.10.12 user=postgres password=change-me dbname=hengshui-tablet port=5432 sslmode=disable TimeZone=Asia/Shanghai
REDIS_PASSWORD=change-meCOS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me

DASHSCOPE_API_KEY=change-me
OPENAI_API_KEY=change-me
EMBEDDING_API_KEY=change-me
ASR_API_KEY=change-me

GORSE_API_KEY=change-me
GORSE_SERVER_API_KEY=change-me
GORSE_DASHBOARD_USERNAME=admin
GORSE_DASHBOARD_PASSWORD=change-meGORSE_CACHE_STORE=postgres://postgres:change-me@host.docker.internal:5432/hengshui-tablet?sslmode=disable&search_path=gorse,public
GORSE_DATA_STORE=postgres://postgres:change-me@host.docker.internal:5432/hengshui-tablet?sslmode=disable&search_path=gorse,public
GORSE_MASTER_GRPC_PORT=8086
GORSE_DASHBOARD_PORT=8088
GORSE_SERVER_PORT=8087
GORSE_WORKER_PORT=8089

MIGRATE_SOURCE_ACCESS_KEY=change-me
MIGRATE_SOURCE_SECRET_KEY=change-me
MIGRATE_TARGET_ACCESS_KEY=change-me
MIGRATE_TARGET_SECRET_KEY=change-me
