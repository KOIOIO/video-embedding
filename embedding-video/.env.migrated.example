# Copy to .env.migrated.local with scripts/init-migrated-env.sh.
# Never commit the generated file.

COMPOSE_PROJECT_NAME=video-embedding-migrated
MIGRATED_POSTGRES_PORT=15432
MIGRATED_REDIS_PORT=16379
MIGRATED_MINIO_PORT=19000
MIGRATED_MINIO_CONSOLE_PORT=19001
VIDEO_APP_HTTP_PORT=18083
VIDEO_APP_WEB_PORT=15173

# Source locations used only by scripts/migrate-local-data.sh.
MIGRATION_SOURCE_ROOT=/absolute/path/to/source-project
MIGRATION_SOURCE_NETWORK=source-project_default
MIGRATION_SOURCE_VIDEO_BUCKET=source-video-bucket

POSTGRES_USER=video_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=video_app
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=videoapp
MINIO_ROOT_PASSWORD=change-me

POSTGRES_DSN="host=127.0.0.1 user=video_app password=change-me dbname=video_app port=15432 sslmode=disable TimeZone=Asia/Shanghai"
REDIS_ADDR=127.0.0.1:16379
COS_ENDPOINT=127.0.0.1:19000
COS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_BUCKET=video-cloud-drive
KNOWLEDGE_VIDEO_BUCKET=knowledge-point-videos
JWT_SECRET=change-me-at-least-32-characters-long

# Optional external AI providers. Leave blank when only testing local startup.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_API_KEY=
ASR_API_KEY=
