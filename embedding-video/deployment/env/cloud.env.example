CLOUD_BIND_ADDRESS=0.0.0.0
VIDEO_APP_HTTP_PORT=8083
VIDEO_APP_API_IMAGE=video-service-api:latest
# Required by the API container; keep stable across upgrades and rotate deliberately.
JWT_SECRET=change-me-at-least-32-characters-long

# Current delivery topology uses sslmode=disable; protect the remote link with VPN/IP allowlists.
POSTGRES_DSN=host=host.docker.internal user=video_app password=change-me dbname=video-app port=15432 sslmode=disable TimeZone=Asia/Shanghai
REDIS_ADDR=host.docker.internal:6379
REDIS_PASSWORD=change-me

COS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
DASHSCOPE_API_KEY=change-me
OPENAI_API_KEY=
EMBEDDING_API_KEY=
ASR_API_KEY=
