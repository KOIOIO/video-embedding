# Copy this file to .env.local for local development.
# Root Compose defaults to .env.deploy; select this file explicitly with:
# VIDEO_APP_ENV_FILE=.env.local docker compose up -d
# Do not commit real secrets. Replace JWT_SECRET with a unique random value.

VIDEO_APP_HTTP_PORT=8083
VIDEO_APP_WEB_PORT=1325
JWT_SECRET=change-me-with-at-least-32-random-characters

POSTGRES_DSN=host=localhost user=postgres password=change-me dbname=video-app port=5432 sslmode=disable TimeZone=Asia/Shanghai
REDIS_PASSWORD=
COS_SECRET_ID=
COS_SECRET_KEY=
RUSTFS_ACCESS_KEY=change-me-local-object-storage-access-key
RUSTFS_SECRET_KEY=change-me-local-object-storage-secret-key

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_API_KEY=
ASR_API_KEY=

GORSE_API_KEY=change-me-gorse-client-api-key
# The client and Gorse server keys must be identical; Go sends X-API-Key.
GORSE_SERVER_API_KEY=change-me-gorse-client-api-key
GORSE_DASHBOARD_USERNAME=admin
GORSE_DASHBOARD_PASSWORD=change-me-local-dashboard-password
GORSE_CACHE_STORE=postgres://postgres:change-me@host.docker.internal:5432/video-app?sslmode=disable&search_path=gorse,public
GORSE_DATA_STORE=postgres://postgres:change-me@host.docker.internal:5432/video-app?sslmode=disable&search_path=gorse,public
GORSE_MASTER_GRPC_PORT=8086
GORSE_DASHBOARD_PORT=8088

MIGRATE_SOURCE_ACCESS_KEY=
MIGRATE_SOURCE_SECRET_KEY=
MIGRATE_TARGET_ACCESS_KEY=
MIGRATE_TARGET_SECRET_KEY=
